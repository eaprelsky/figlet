PORT=3400
HOST=127.0.0.1
# Optional shared key. Without it, readers enter their own key in Settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional OpenAI-compatible gateway, e.g. the provider used by your deployment.
AI_BASE_URL=https://api.deepseek.com
AI_PROVIDER_NAME=DeepSeek
# Docker overrides this with /app/data/cache.sqlite in a persistent volume.
CACHE_DB=.figlet-data/cache.sqlite

# Free tier and subscriptions
# New books per week on the shared key before a personal key or subscription is required.
FREE_BOOKS_PER_WEEK=5
SUBSCRIPTION_PRICE_RUB=199
SUBSCRIPTION_DAYS=30
# YooKassa shop for subscriptions; notify URL: https://<host>/api/billing/notify
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Accounts (optional for readers). Comma-separated logins get the admin role.
FIGLET_ADMIN_LOGINS=

# Whole-book background indexing: max sections per job.
INDEXER_MAX_NODES=150
